# Copy to .env and fill in only what you need — every value below has a
# safe default, and the platform runs fully (with AI disabled) with no
# .env file at all. Never commit a real .env file.

# ---------------------------------------------------------------------------
# apps/web (Next.js) — only needed once services/analyzer is actually running
# and you want the frontend to call it instead of demo data.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ANALYZER_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# services/analyzer (FastAPI) — see services/analyzer/app/config.py for the
# full list and current defaults. Set via docker-compose.yml's `environment:`
# block for local dev, or your own deployment's secrets manager.
# ---------------------------------------------------------------------------

# Where per-analysis workspaces (uploaded/extracted/compiled files) live.
# Cleaned up automatically after each analysis.
FLARE_WORKSPACE_DIR=/srv/analyzer/workspaces

# SQLite database path (analyses table + content-hash cache).
FLARE_DB_PATH=/srv/analyzer/data/flare.db

# Where the 40-fixture benchmark suite lives — used by the "Benchmark
# Case" intake method and the benchmark/holdout runners. The default
# matches docker-compose.yml's mount; only change this for a non-Docker
# setup.
FLARE_BENCHMARKS_DIR=/srv/contracts/benchmarks

# disabled | local | api-key — AI only explains existing findings, never
# creates one, and the full pipeline works with this left as "disabled".
FLARE_AI_PROVIDER=disabled

# Optional: enables the "verified contract address" intake method via a
# free-tier block-explorer API (e.g. Etherscan). Every other intake method
# (file upload, ZIP, GitHub URL) works without this set.
FLARE_ETHERSCAN_API_KEY=

# Optional: only used if FLARE_AI_PROVIDER=api-key. Never required for the
# core deterministic pipeline.
FLARE_AI_API_KEY=
