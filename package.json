{
  "name": "flare-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "FLARE — Fund-Lock Assessment and Risk Evaluation",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx,json,css}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,mdx,json,css}\" --cache"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
